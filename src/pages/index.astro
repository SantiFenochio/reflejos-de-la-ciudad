---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { HOME_QUERY, DESTACADAS_QUERY } from '../lib/queries';
import type { Articulo } from '../types/article';
import Publicidad from '../components/ui/Publicidad.astro';
import { formatearFecha } from '../lib/utils';
import { logger } from '../lib/logger';
import bannerMujeres from '../assets/Banner_EspacioMujeres_500x100.gif';
import bannerOjos from '../assets/banner-instituto-medico-de-ojos.gif';
import bannerDonLuis from '../assets/BannersCuadrados/banner-don-luis-260-X-260.gif';
import bannerUnionIndustrial from '../assets/BannersCuadrados/banner-union-industrial-260-X-260.gif';
import bannerCuadrado3 from '../assets/BannersCuadrados/ezgif-330bf48de539c120.gif';

// Noticias: hero + hasta 9 cards en grilla (para dar lugar a intercalados)
let notas: Articulo[] = [];
try {
  notas = await sanityClient.fetch(HOME_QUERY);
} catch (e) {
  logger.warn('index', 'No se pudo obtener notas', e);
}

// Destacadas: notas marcadas con featured == true en Sanity.
let destacadas: Articulo[] = [];
try {
  destacadas = await sanityClient.fetch(DESTACADAS_QUERY);
} catch (e) {
  logger.warn('index', 'No se pudo obtener destacadas', e);
}

// Publicidades: todas activas, ordenadas por campo "orden" asc
let publicidades: any[] = [];
try {
  publicidades = await sanityClient.fetch(
    `*[_type == "publicidad" && activa == true] | order(orden asc) {
      _id, nombre, linkDestino, posicion,
      "imagenUrl": imagen.asset->url
    }`
  );
} catch (e) {
  logger.warn('index', 'No se pudo obtener publicidades', e);
}

// Cache CDN de Vercel: 5 min fresco, 1 hora stale-while-revalidate.
// El webhook /api/revalidate invalida el tag 'home' al publicar contenido nuevo.
Astro.response.headers.set('Vercel-CDN-Cache-Control', 's-maxage=300, stale-while-revalidate=3600');
Astro.response.headers.set('Cache-Tag', 'home');

const hero             = notas[0] ?? null;
const notasSecundarias = notas.slice(1, 5);   // 4 notas: grilla 2x2 a la derecha del hero (estilo Edición Calificada)
const grilla           = notas.slice(5, 14);  // 9 notas: arranca en 5 para no repetir ni saltear (1 + 4 + 9 = 14)
// Carrusel "Destacadas": usa las notas marcadas con featured en Sanity.
// Si todavía no hay ninguna marcada, cae de vuelta a las notas recientes.
const carrusel         = destacadas.length > 0 ? destacadas : grilla;
const mobileAdFrequency = 3;
const mobileInlineAdsCount = Math.min(publicidades.length, Math.ceil(grilla.length / mobileAdFrequency));
const mobileRemainingAds = publicidades.slice(mobileInlineAdsCount);

// Hero image - responsive srcset para diferentes tamaños de pantalla
const heroImg = hero?.imagen
  ? urlFor(hero.imagen).width(1000).height(750).fit('crop').crop('focalpoint').format('webp').url()
  : 'https://picsum.photos/seed/hero-rdlc/1000/750';

const heroSrcset = hero?.imagen
  ? `${urlFor(hero.imagen).width(600).height(450).fit('crop').crop('focalpoint').format('webp').url()} 600w,
     ${urlFor(hero.imagen).width(800).height(600).fit('crop').crop('focalpoint').format('webp').url()} 800w,
     ${urlFor(hero.imagen).width(1000).height(750).fit('crop').crop('focalpoint').format('webp').url()} 1000w,
     ${urlFor(hero.imagen).width(1200).height(900).fit('crop').crop('focalpoint').format('webp').url()} 1200w`
  : undefined;


---

<BaseLayout
  title="Reflejos de la Ciudad — Noticias de San Martín y Villa Ballester"
  description="Diario digital local de General San Martín y Villa Ballester, Buenos Aires. Noticias de política, cultura, deportes, vecinos y más."
  image="/og-default.jpg"
>
  {hero?.imagen && (
    <link slot="head" rel="preload" as="image" href={heroImg} fetchpriority="high" />
  )}

<!-- ============================================================
     HERO — 1 grande + 4 a la derecha (grilla 2x2)
     Estilo "título sobre la imagen" para las 5 fotos (mobile + desktop),
     inspirado en Edición Calificada pero con la identidad de Reflejos.
     ============================================================ -->
<section class="hero-bento-section mt-8 -mx-4">
  <div class="hero-bento">

    <!-- ── NOTA PRINCIPAL (grande): ocupa 2x2 en desktop ── -->
    {hero ? (
      <article class="hero-item hero-grande">
        <a href={`/nota/${hero.slug.current}`} aria-label={hero.titulo}>
          <img
            src={heroImg}
            srcset={heroSrcset}
            sizes="(max-width: 1024px) 100vw, 600px"
            alt={hero.titulo}
            width="1000"
            height="750"
            class="hero-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-overlay" aria-hidden="true"></div>
          <div class="hero-meta">
            {hero.categoria && <span class="hero-badge">{hero.categoria}</span>}
            <h1 class="hero-titulo hero-titulo-grande">{hero.titulo}</h1>
            {hero.bajada && <p class="hero-bajada">{hero.bajada}</p>}
            <p class="hero-fecha">
              {hero.autor && <span>Por {hero.autor}</span>}
              {hero.autor && <span aria-hidden="true"> &middot; </span>}
              <span>{formatearFecha(hero.fechaPublicacion)}</span>
            </p>
          </div>
        </a>
      </article>
    ) : (
      <div class="hero-item hero-grande hero-empty">
        <p>Publica tu primera nota en Sanity para verla aquí</p>
      </div>
    )}

    <!-- ── 4 NOTAS SECUNDARIAS: grilla 2x2 a la derecha ── -->
    {notasSecundarias.map((nota) => {
      const imgSec = nota.imagen
        ? urlFor(nota.imagen).width(600).height(450).fit('crop').crop('focalpoint').format('webp').url()
        : `https://picsum.photos/seed/sec-${nota.slug.current}/600/450`;
      return (
        <article class="hero-item hero-chica">
          <a href={`/nota/${nota.slug.current}`} aria-label={nota.titulo}>
            <img
              src={imgSec}
              alt={nota.titulo}
              width="600"
              height="450"
              loading="eager"
              decoding="async"
              class="hero-img"
            />
            <div class="hero-overlay" aria-hidden="true"></div>
            <div class="hero-meta">
              {nota.categoria && <span class="hero-badge hero-badge-sm">{nota.categoria}</span>}
              <h2 class="hero-titulo hero-titulo-chica">{nota.titulo}</h2>
            </div>
          </a>
        </article>
      );
    })}

  </div>
</section>

<!-- ============================================================
     BANNERS PUBLICITARIOS DUO — horizontal, una línea (desktop)
     Se ubican debajo de las primeras notas y arriba del separador.
     ============================================================ -->
<section class="banners-duo" aria-label="Publicidad">
  <a
    href="https://sanmartin.gob.ar/comunidades/interna/mujeres-espacio-mujeres/"
    class="banner-duo-item"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Espacio Mujeres — Municipio de San Martín"
  >
    <img
      src={bannerMujeres.src}
      width={bannerMujeres.width}
      height={bannerMujeres.height}
      alt="Espacio Mujeres — Municipio de General San Martín"
      loading="lazy"
      decoding="async"
    />
  </a>
  <a
    href="https://clinicaimo.com/"
    class="banner-duo-item"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instituto Médico de Ojos"
  >
    <img
      src={bannerOjos.src}
      width={bannerOjos.width}
      height={bannerOjos.height}
      alt="Instituto Médico de Ojos"
      loading="lazy"
      decoding="async"
    />
  </a>
</section>

<!-- Separador triple estilo diario -->
<div class="separador-triple">
  <div class="sep-linea"></div>
  <div class="sep-linea gruesa"></div>
  <div class="sep-linea"></div>
</div>

<!-- ============================================================
     CARRUSEL DE DESTACADAS
     CSS scroll-snap + flechas + dots + autoscroll JS vanilla
     ============================================================ -->
{carrusel.length > 0 && (
  <section class="car-section">
    <div class="sec-header">
      <span class="sec-barra-roja"></span>
      <h2 class="sec-titulo">Destacadas</h2>
      <div class="sec-linea"></div>
    </div>

    <div class="car-outer">
      <!-- Flecha izquierda -->
      <button class="car-btn car-prev" id="car-prev" aria-label="Nota anterior">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <!-- Track con scroll-snap -->
      <div class="car-track" id="car-track">
        {carrusel.map((nota, i) => {
          const imgUrl = nota.imagen
            ? urlFor(nota.imagen).width(600).height(338).fit('crop').crop('focalpoint').format('webp').url()
            : `https://picsum.photos/seed/car-${nota.slug.current}/600/338`;
          return (
            <div class="car-slide" data-index={i}>
              <a href={`/nota/${nota.slug.current}`} class="car-img-wrap">
                <img src={imgUrl} alt={nota.titulo} width="600" height="400" loading="lazy" class="car-img" />
              </a>
              <div class="car-body">
                {nota.categoria && <span class="badge-rojo badge-sm">{nota.categoria}</span>}
                <h3 class="car-titulo">
                  <a href={`/nota/${nota.slug.current}`} class="car-titulo-lnk">{nota.titulo}</a>
                </h3>
                {nota.bajada && <p class="car-bajada">{nota.bajada}</p>}
                <p class="car-meta">{formatearFecha(nota.fechaPublicacion)}</p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Flecha derecha -->
      <button class="car-btn car-next" id="car-next" aria-label="Nota siguiente">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

    <!-- Dots + contador -->
    <div class="car-footer">
      <div class="car-dots" id="car-dots" role="tablist">
        {carrusel.map((_, i) => (
          <button
            class={`car-dot${i === 0 ? ' active' : ''}`}
            data-index={i}
            aria-label={`Ir a nota ${i + 1}`}
            role="tab"
          ></button>
        ))}
      </div>
      <span class="car-contador" id="car-contador" aria-live="polite">
        1 / {carrusel.length}
      </span>
    </div>
  </section>
)}

<!-- ============================================================
     BANNERS PUBLICITARIOS CUADRADOS — entre Destacadas y Ultimas Noticias
     Se alinean por altura uniforme en una fila centrada (desktop)
     y se apilan a ancho controlado en mobile.
     ============================================================ -->
<section class="banners-trio" aria-label="Publicidad">
  <div class="banner-trio-item">
    <a href="https://uidgsm.org.ar/" target="_blank" rel="noopener noreferrer">
      <img
        src={bannerUnionIndustrial.src}
        width={bannerUnionIndustrial.width}
        height={bannerUnionIndustrial.height}
        alt="Unión Industrial de General San Martín"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
  <div class="banner-trio-item banner-trio-item--wide">
    <a href="https://iballester.edu.ar/" target="_blank" rel="noopener noreferrer">
      <img
        src={bannerCuadrado3.src}
        width={bannerCuadrado3.width}
        height={bannerCuadrado3.height}
        alt="Publicidad"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
  <div class="banner-trio-item">
    <a href="https://www.instagram.com/panaderiadonluis/?hl=es" target="_blank" rel="noopener noreferrer">
      <img
        src={bannerDonLuis.src}
        width={bannerDonLuis.width}
        height={bannerDonLuis.height}
        alt="Delivery Don Luis"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</section>

<!-- Separador triple estilo diario -->
<div class="separador-triple">
  <div class="sep-linea"></div>
  <div class="sep-linea gruesa"></div>
  <div class="sep-linea"></div>
</div>

<!-- ============================================================
     CUERPO: GRILLA DE NOTICIAS + SIDEBAR
     ============================================================ -->
<div class="cuerpo-grid">

  <!-- COLUMNA PRINCIPAL: noticias + cargar más -->
  <div class="col-principal">
    <section>
      <div class="sec-header">
        <span class="sec-barra-roja"></span>
        <h2 class="sec-titulo">Ultimas Noticias</h2>
        <div class="sec-linea"></div>
      </div>

      {grilla.length > 0 ? (
        <div class="notas-grid">
          {grilla.map((nota, i) => {
            const imgUrl = nota.imagen
              ? urlFor(nota.imagen).width(600).height(338).fit('crop').crop('focalpoint').format('webp').url()
              : `https://picsum.photos/seed/${nota.slug.current}/600/338`;
            const shouldShowMobileAd = (i + 1) % mobileAdFrequency === 0;
            const mobileAdIndex = Math.floor(i / mobileAdFrequency);
            const mobileAd = shouldShowMobileAd ? publicidades[mobileAdIndex] : null;
            return (
              <Fragment>
                <article class="card animar">
                  <a href={`/nota/${nota.slug.current}`} class="card-img-wrap">
                    <img src={imgUrl} alt={nota.titulo} width="600" height="338" loading="lazy" class="card-img object-cover object-center" />
                    {nota.categoria && <span class="badge-rojo badge-sm badge-sobre-img">{nota.categoria}</span>}
                  </a>
                  <div class="card-body">
                    <h2 class="card-titulo">
                      <a href={`/nota/${nota.slug.current}`} class="card-titulo-lnk">{nota.titulo}</a>
                    </h2>
                    {nota.bajada && <p class="card-bajada">{nota.bajada}</p>}
                    <p class="card-meta">
                      {nota.autor && <span>Por {nota.autor}</span>}
                      {nota.autor && <span aria-hidden="true"> &middot; </span>}
                      <span>{formatearFecha(nota.fechaPublicacion)}</span>
                    </p>
                  </div>
                </article>
                {mobileAd && (
                  <div class="pub-mobile-inline">
                    <p class="pub-mobile-inline-label">Publicidad</p>
                    <Publicidad pub={mobileAd} />
                  </div>
                )}
              </Fragment>
            );
          })}
        </div>
      ) : (
        <p class="msg-empty">Proximamente mas noticias.</p>
      )}
      {mobileRemainingAds.length > 0 && (
        <div class="pub-mobile-extra-wrap">
          {mobileRemainingAds.map((pub: any) => (
            <div class="pub-mobile-inline">
              <p class="pub-mobile-inline-label">Publicidad</p>
              <Publicidad pub={pub} />
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- CARGAR MÁS — dentro de la columna principal.
         Solo se muestra si la home llenó las 14 notas iniciales:
         si hay menos, ya están todas en pantalla y no hay nada que paginar. -->
    {notas.length >= 14 && (
      <div id="cargar-mas-wrap" style="text-align:center;margin-top:2rem;">
        <button id="btn-cargar-mas" class="btn-cargar-mas" data-offset="14">
          Cargar más noticias
        </button>
        <p id="cargar-mas-fin" class="cargar-mas-fin" hidden>No hay más noticias.</p>
      </div>
    )}
  </div>{/* fin col-principal */}

  <!-- SIDEBAR: Publicidades primero, luego redes -->
  <aside class="sidebar">

    <!-- Publicidades: TODAS las activas ordenadas por campo "orden" — al tope para máxima visibilidad -->
    {publicidades.length > 0 ? (
      <div class="pubs-wrap">
        <p class="pubs-label">Publicidad</p>
        {publicidades.map((pub: any) => (
          <Publicidad pub={pub} />
        ))}
      </div>
    ) : (
      <div class="pub-box">
        <p class="pub-label">Espacio Publicitario</p>
        <p class="pub-nombre">Anuncia en Reflejos</p>
        <p class="pub-desc">Llega a toda la comunidad de San Martin y sus alrededores</p>
        <a href="mailto:reflejosdelaciudad@yahoo.com.ar" class="pub-btn">Consultanos</a>
      </div>
    )}


  </aside>

</div>{/* fin cuerpo-grid */}

</BaseLayout>


<style is:global>
  /* ============================================================
     HERO BENTO — 1 grande + 4 a la derecha (grilla 2x2)
     Título sobre la imagen con degradado, badge de categoría y zoom al hover.
     ============================================================ */
  .hero-bento {
    display: grid;
    grid-template-columns: 1fr;   /* mobile: 1 columna, todas apiladas */
    gap: 4px;                      /* gaps ajustados, estilo diario */
  }
  @media (min-width: 1024px) {
    .hero-bento {
      grid-template-columns: 2fr 1fr 1fr;  /* grande 50% + 2 columnas de 25% */
    }
    .hero-grande { grid-column: 1; grid-row: 1 / 3; }  /* ocupa el bloque 2x2 */
  }

  .hero-item {
    position: relative;
    overflow: hidden;
    background: #14110e;
    aspect-ratio: 4 / 3;           /* todas 4:3 (como Edición Calificada) */
    border-radius: 2px;
  }
  @media (min-width: 1024px) {
    .hero-grande { aspect-ratio: auto; }  /* en desktop llena su área 2x2 */
  }
  .hero-item > a {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-item:hover .hero-img { transform: scale(1.06); }
  }
  .hero-item:active .hero-img { transform: scale(1.02); }

  /* Degradado oscuro de abajo hacia arriba para legibilidad del título */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.90) 0%, rgba(0,0,0,0.50) 36%, rgba(0,0,0,0) 66%);
    transition: background 0.3s ease;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-item:hover .hero-overlay {
      background: linear-gradient(to top, rgba(0,0,0,0.94) 0%, rgba(0,0,0,0.58) 42%, rgba(0,0,0,0.06) 72%);
    }
  }

  /* Texto sobre la imagen */
  .hero-meta {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 0.8rem 0.95rem;
    z-index: 2;
  }
  .hero-grande .hero-meta { padding: 1.25rem 1.4rem; }

  .hero-badge {
    display: inline-block;
    background: var(--color-acento);
    color: #fff;
    font-family: var(--font-cuerpo);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.28rem 0.6rem;
    margin-bottom: 0.5rem;
    border-radius: 2px;
  }
  .hero-badge-sm { font-size: 0.55rem; padding: 0.22rem 0.5rem; margin-bottom: 0.35rem; }

  .hero-titulo {
    font-family: var(--font-titular);
    color: #fff;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 0;
    text-shadow: 0 1px 14px rgba(0,0,0,0.5);
  }
  .hero-titulo-grande { font-size: clamp(1.4rem, 2.1vw, 2.3rem); }
  .hero-titulo-chica {
    font-size: 0.98rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .hero-titulo-chica { font-size: 1rem; -webkit-line-clamp: 2; }
  }
  .hero-item:hover .hero-titulo { text-decoration: underline; text-underline-offset: 3px; }

  /* Bajada: solo en la grande y solo en desktop (mobile prioriza el título) */
  .hero-bajada { display: none; }
  @media (min-width: 1024px) {
    .hero-bajada {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-family: var(--font-cuerpo);
      color: rgba(255,255,255,0.92);
      font-style: italic;
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0.5rem 0 0;
    }
  }
  .hero-fecha {
    font-family: var(--font-cuerpo);
    color: rgba(255,255,255,0.8);
    font-size: 0.72rem;
    margin: 0.55rem 0 0;
  }

  /* Placeholder sin nota */
  .hero-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5e5e0;
  }
  .hero-empty p { color: #666; font-size: 0.9rem; padding: 1rem; text-align: center; margin: 0; }
  @media (min-width: 1024px) {
    .hero-grande.hero-empty { min-height: 400px; }
  }
</style>

<style is:global>
  /* BADGES MEJORADOS */
  .badge-rojo {
    display: inline-block; background: var(--color-acento); color: #fff;
    font-family: var(--font-cuerpo); font-size: 0.65rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 0.35rem 0.85rem; margin-bottom: 0.6rem;
    border-radius: 2px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .badge-rojo:hover {
    background: var(--color-acento-hover);
    transform: scale(1.05);
  }
  .badge-sm { font-size: 0.6rem; padding: 0.3rem 0.7rem; margin-bottom: 0.5rem; }

  /* SEPARADOR TRIPLE MEJORADO */
  .separador-triple { display: flex; flex-direction: column; gap: 3px; margin: 2rem 0 2.25rem; }
  .sep-linea { border-top: 1px solid var(--color-periodico); }
  .sep-linea.gruesa { border-top-width: 3px; border-top-color: var(--color-acento); }

  /* BANNERS PUBLICITARIOS DUO — dos banners horizontales en una línea */
  .banners-duo {
    display: flex;
    gap: 1rem;
    align-items: stretch;
    justify-content: center;
    margin: 2rem 0 0;
  }
  .banner-duo-item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s var(--ease-out), opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    a.banner-duo-item:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }
  }
  a.banner-duo-item:active { transform: scale(0.98); }
  .banner-duo-item img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  /* Mobile: se apilan, ambos a ancho completo (igual de importantes) */
  @media (max-width: 768px) {
    .banners-duo { flex-direction: column; gap: 0.75rem; margin-top: 1.5rem; }
    .banner-duo-item { width: 100%; }
  }

  /* BANNERS PUBLICITARIOS CUADRADOS — fila a ancho completo, misma altura.
     El ancho se reparte proporcional al aspecto de cada banner (flex-grow),
     de modo que los tres terminan con la misma altura y llenan toda la fila. */
  .banners-trio {
    display: flex;
    gap: 1.25rem;
    align-items: stretch;
    margin: 2rem 0 0;
  }
  .banner-trio-item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  /* El banner apaisado (800x441) recibe más ancho para igualar la altura */
  .banner-trio-item--wide { flex-grow: 1.81; }
  .banner-trio-item a {
    display: block;
    width: 100%;
    transition: transform 0.2s var(--ease-out), opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .banner-trio-item a:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }
  }
  .banner-trio-item a:active { transform: scale(0.98); }
  .banner-trio-item img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  /* Mobile: se apilan centrados con ancho controlado */
  @media (max-width: 768px) {
    .banners-trio { flex-direction: column; gap: 1rem; margin-top: 1.5rem; align-items: center; }
    .banner-trio-item { width: 100%; }
    .banner-trio-item img { width: 100%; max-width: 320px; }
  }

  /* ENCABEZADO DE SECCION */
  .sec-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; }
  .sec-barra-roja { display: inline-block; width: 4px; height: 1.3rem; background: #4c6a92; flex-shrink: 0; }
  .sec-titulo {
    font-family: var(--font-cuerpo); font-size: 0.68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.2em; color: #1a1a1a; margin: 0;
  }
  .sec-linea { flex: 1; height: 1px; background: #D0D0D0; margin-left: 0.25rem; }

  /* LAYOUT PRINCIPAL: dos columnas fijas */
  .cuerpo-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }
  /* Columna izquierda: noticias + cargar más apilados */
  .col-principal { display: flex; flex-direction: column; min-width: 0; }

  /* Mobile: una sola columna */
  @media (max-width: 768px) {
    .cuerpo-grid { grid-template-columns: 1fr; }
    .sidebar { display: none; } /* ads se muestran inline entre noticias en mobile */
  }

  /* GRILLA DE NOTICIAS */
  .notas-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 480px)  { .notas-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
  @media (min-width: 640px)  { .notas-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; } }
  @media (min-width: 1024px) { .notas-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }

  .empty-msg { font-family: var(--font-cuerpo); color: #888; font-size: 0.95rem; padding: 2rem 0; text-align: center; }
</style>

