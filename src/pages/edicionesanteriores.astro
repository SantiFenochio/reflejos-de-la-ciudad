---
// src/pages/edicionesanteriores.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from '../lib/sanity';
import { formatearFecha } from '../lib/utils';
import { ordenarEdiciones, urlPortada } from '../lib/ediciones';
import { logger } from '../lib/logger';

interface Edicion {
  _id:        string;
  titulo:     string;
  fecha:      string;
  pdfUrl:     string | null;
  portadaUrl: string | null;
}

const query = `*[_type == "edicionImpresa"] | order(fecha desc) {
  _id,
  titulo,
  fecha,
  "pdfUrl": archivoPdf.asset->url,
  "portadaUrl": imagenPortada.asset->url
}`;

let ediciones: Edicion[] = [];
try {
  // Reordenamos en JS además del order() de GROQ: si el campo `fecha` quedó mal
  // cargado en el Studio, manda la fecha que figura en el título — que es la que
  // ve el lector — y la grilla nunca aparece desordenada.
  ediciones = ordenarEdiciones(await sanityClient.fetch<Edicion[]>(query));
} catch (e) {
  logger.warn('edicionesanteriores', 'No se pudo obtener ediciones', e);
}
---

<BaseLayout
  title="Ediciones Anteriores — Reflejos de la Ciudad"
  description="Archivo histórico de todas las ediciones impresas semanales del diario Reflejos de la Ciudad, San Martín, Buenos Aires."
>

  <!-- Encabezado de sección al estilo diario clásico -->
  <div class="border-b-2 border-periodico mb-8 pb-3">
    <h1 style="font-family:var(--font-titular);font-size:2rem;font-weight:700;color:var(--color-periodico);letter-spacing:-0.01em;">
      Archivo de Ediciones Impresas
    </h1>
    <p style="font-family:var(--font-cuerpo);font-size:0.85rem;color:#4A4A4A;margin-top:0.25rem;">
      Todas las ediciones semanales disponibles para descargar o consultar en línea.
    </p>
  </div>

  {ediciones.length === 0 ? (
    <!-- Estado vacío: todavía no se subió ninguna edición -->
    <div class="msg-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 1rem;" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="9" y1="13" x2="15" y2="13"/>
        <line x1="9" y1="17" x2="12" y2="17"/>
      </svg>
      <p style="font-family:var(--font-titular);font-size:1.15rem;color:#555;">
        Próximamente se publicarán las ediciones aquí.
      </p>
    </div>
  ) : (
    <>
    <ul class="ediciones-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;list-style:none;padding:0;margin:0;">
      {ediciones.map((ed, i) => (
        <li class:list={["card-hover-lift", { "edicion-oculta": i >= 20 }]} style="background:#fff;border:1px solid var(--color-borde);border-radius:2px;padding:0;display:flex;flex-direction:column;overflow:hidden;">
          <!-- Portada: primera página del PDF como vista previa -->
          {ed.pdfUrl ? (
            <a href={ed.pdfUrl} target="_blank" rel="noopener noreferrer" class="portada-link" aria-label={`Ver edición: ${ed.titulo}`}>
              <!-- Si la edición todavía no tiene imagenPortada en Sanity, urlPortada()
                   apunta a /api/portada/[id].jpg, que renderiza la 1ª hoja del PDF. -->
              <img
                src={urlPortada(ed)}
                alt={`Portada de la edición del ${ed.titulo}`}
                width="440"
                height="570"
                loading="lazy"
                class="portada-img"
              />
            </a>
          ) : (
            <div class="portada-placeholder" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9aa7bb" stroke-width="1.5" stroke-linecap="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            </div>
          )}

          <div style="padding:1rem 1.1rem 1rem;display:flex;flex-direction:column;gap:0.75rem;flex:1;">
            <!-- Título de la edición (fecha) -->
            <p style="font-family:var(--font-titular);font-size:1.05rem;font-weight:700;color:var(--color-periodico);line-height:1.3;letter-spacing:-0.01em;margin:0;flex:1;">
              {ed.titulo}
            </p>

            <!-- Botón -->
            {ed.pdfUrl ? (
            <a
              href={ed.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-descarga-pdf"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Ver / Descargar PDF
            </a>
            ) : (
              <span style="font-family:var(--font-cuerpo);font-size:0.7rem;color:#aaa;font-style:italic;">
                PDF no disponible
              </span>
            )}
          </div>
        </li>
      ))}
    </ul>

    {ediciones.length > 20 && (
      <div class="cargar-mas-wrap">
        <button id="btn-cargar-mas" class="btn-cargar-mas" type="button">
          Cargar más ediciones
          <span class="cargar-mas-restantes">(<span id="cargar-mas-num">{ediciones.length - 20}</span> restantes)</span>
        </button>
      </div>
    )}
    </>
  )}

</BaseLayout>

<script>
  // Revela las ediciones ocultas de a 20 por clic.
  const PASO = 20;
  const btn = document.getElementById('btn-cargar-mas');
  const numEl = document.getElementById('cargar-mas-num');

  btn?.addEventListener('click', () => {
    const ocultas = document.querySelectorAll('.ediciones-grid > .edicion-oculta');
    let reveladas = 0;
    for (const el of ocultas) {
      el.classList.remove('edicion-oculta');
      reveladas += 1;
      if (reveladas >= PASO) break;
    }
    const quedan = document.querySelectorAll('.ediciones-grid > .edicion-oculta').length;
    if (numEl) numEl.textContent = String(quedan);
    if (quedan === 0) btn.parentElement?.remove();
  });
</script>

<style>
  /* FIX #8: grid responsivo para ediciones anteriores */
  @media (min-width: 640px)  { .ediciones-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 1.25rem !important; } }
  @media (min-width: 1024px) { .ediciones-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 1.5rem !important; } }

  /* Paginación: ediciones más allá de las primeras 20 ocultas hasta "Cargar más" */
  .edicion-oculta { display: none !important; }

  .cargar-mas-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }
  .btn-cargar-mas {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 2rem;
    background: #fff;
    color: var(--color-periodico);
    border: 1.5px solid var(--color-periodico);
    font-family: var(--font-cuerpo);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .btn-cargar-mas:hover {
    background: var(--color-periodico);
    color: #fff;
    transform: translateY(-2px);
  }
  .cargar-mas-restantes {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  /* Portada (vista previa de la primera página del PDF) */
  .portada-link {
    display: block;
    line-height: 0;
    background: #f0f2f5;
    border-bottom: 1px solid var(--color-borde);
    overflow: hidden;
  }
  .portada-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 44 / 57;          /* proporción tabloide vertical */
    object-fit: cover;
    object-position: top center;     /* muestra el cabezal y los titulares */
    transition: transform 0.3s ease;
  }
  .portada-link:hover .portada-img { transform: scale(1.03); }
  .portada-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 44 / 57;
    background: #f0f2f5;
    border-bottom: 1px solid var(--color-borde);
  }

  /* Botón descarga PDF mejorado */
  .btn-descarga-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background: var(--color-acento);
    color: #fff;
    font-family: var(--font-cuerpo);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    align-self: flex-start;
    border-radius: 2px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .btn-descarga-pdf:hover {
    background: var(--color-acento-hover);
    transform: translateY(-2px);
  }
</style>
